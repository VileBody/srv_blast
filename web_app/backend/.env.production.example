MODE=prod
BLAST_BACKEND_MODE=production
APP_URL=https://app.blast808.com
BLAST_CORS_ORIGINS=https://app.blast808.com
BLAST_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Web state and the public bot credit ledger are separate URLs, even when they
# live in the same PostgreSQL cluster.
DATABASE_URL=postgresql://user:password@postgres.example:5432/blast_web
CREDITS_DB_URL=postgresql://user:password@postgres.example:5432/blast_credits
REDIS_URL=redis://redis.example:6379/0

ORCHESTRATOR_PUBLIC_URL=http://orchestrator.internal:8000

S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_REGION=ru-1
S3_BUCKET_RAW_AUDIO=replace-me
S3_RAW_AUDIO_PREFIX=raw-audio
S3_BUCKET_ASSET_STORAGE=replace-me
S3_WEB_ASSET_PREFIX=app/blast808

WEB_STAGE1_ALIGNMENT_BACKEND=local_ctc
WEB_SUBTITLE_MODE_MAP_JSON={"Brat":"brat_5th","Jakson":"scenes_3rd","Impulse":"impulse_2nd","Tape":"template_4th","Trendy":"trendy_5th"}
WEB_FOOTAGE_ARTIST_MAP_JSON={"Ночной город":"hiphop_atmospheric_dark","Неон":"electro_synthwave","Закат":"pop_romantic","Бэкстейдж":"hiphop_ambition_flex","Улица":"hiphop_aggressive_street","Пустынный закат":"pop_romantic","Крупный план":"hiphop_sensual_rnb","Студийный свет":"pop_dance","Уличный кадр":"hiphop_aggressive_street"}

# Every production choice shown in the wizard must have a real HTTPS or S3
# preview. Names must also exist in the matching maps above. Add more entries
# after the preview objects have been uploaded; startup verifies S3 objects.
WEB_FOOTAGE_CATALOG_JSON=[{"id":"night-city","name":"Ночной город","previewUrl":"s3://replace-me/footage_bucket_previews/night-city.mp4","score":1.0}]
WEB_PHOTO_CATALOG_JSON=[{"id":"photo-desert","name":"Пустынный закат","previewUrl":"s3://replace-me/photo_bucket_previews/photo-desert.mp4","score":1.0}]
WEB_SUBTITLE_CATALOG_JSON=[{"id":"impulse","name":"Impulse","previewUrl":"s3://replace-me/subtitle_previews/impulse.mp4","score":1.0}]

TBANK_TERMINAL_KEY=replace-me
TBANK_PASSWORD=replace-me
TBANK_NOTIFY_URL=https://replace-with-existing-public-bot-host/api/tbank/notify

TELEGRAM_BOT_TOKEN=replace-with-dedicated-web-auth-bot-token
TELEGRAM_BOT_USERNAME=replace-with-web-auth-bot-username

GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=https://app.blast808.com/api/auth/google/callback

TIKTOK_CLIENT_KEY=replace-me
TIKTOK_CLIENT_SECRET=replace-me
TIKTOK_REDIRECT_URI=https://app.blast808.com/api/tiktok/callback
TIKTOK_SCOPES=user.info.basic,video.list,video.publish,video.upload
TIKTOK_TOKEN_KEY=replace-with-fernet-key
