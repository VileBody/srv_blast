{
  "version": 2,
  "note": "Большой реестр: эффекты + брендинг + звук. Всё синхронизируется относительно ДРОПА (drop_time). Пайплайн читает manifest, прокидывает в CONFIG скрипта тайминги/плейсмент и запускает headless на рендер-ноде.",

  "sync": {
    "anchor": "drop_time",
    "desc": "drop_time — мастер-якорь (момент дропа в ролике, известен пайплайну). Эффекты и звуки позиционируются относительно него: layer.startTime = drop_time + offset. У звука с импульсом внутри файла аудио стартует так, чтобы импульс лёг на дроп: audio.inPoint = drop_time - impact_at.",
    "example_hook_light": "Light Sound: импульс на 0.5с -> audio.inPoint = drop_time - 0.5; сам эффект hook light тоже выставлен относительно drop_time."
  },

  "apply_modes": {
    "adjustment":     "adjustment-слой со стеком эффектов поверх видео (place=below:Текст)",
    "cut_overlay":    "белый солид-вспышка в inPoint клипов (на склейках)",
    "clip_transform": "анимирует сам слой-футаж (scale/rotation/blur)",
    "overlay_png":    "PNG поверх (лого-штамп / watermark)"
  },

  "groups": {
    "hook":       "Эффект-хук в начале ролика (+ звук + лого-штамп)",
    "transition": "Переход/удар на склейке или бите",
    "extra":      "Стилизация/грейд футажа перед дропом"
  },

  "branding": {
    "logo_default": "logo/group_1245.png",
    "logo_pool_dir": "logo",
    "logo_pool_note": "S3-prefix внутри FX_ASSETS_S3_PREFIX. Кидай альтернативные лого в logo/ — picker возьмёт детерминированный (seed = JOB_ID).",
    "script": "branding/brand_logo.jsx",
    "styles": {
      "stamp_flash": { "scale": 23, "effects": ["Minimax(Radius 326->0->300)", "Brightness +150"], "opacity": "100->0", "sync": "on_drop", "desc": "Лого вспыхивает-штампуется на дропе (паттерн из shutter)." },
      "clean_fade":  { "scale": 23, "opacity": "0->100->0", "desc": "Мягкое проявление/угасание." },
      "corner_watermark": { "scale": 12, "position": "corner", "opacity": 60, "persistent": true, "desc": "Мелкое лого в углу весь ролик." },
      "glitch_in":   { "scale": 23, "pair_sound": "Glitch Transform", "desc": "Появляется с глитчем." }
    },
    "default_style": "stamp_flash",
    "applies_to": ["hook"]
  },

  "sounds": {
    "root": "sounds",
    "_paths_note": "Все pool и file пути — S3-keys относительно FX_ASSETS_S3_PREFIX (см. .env). Подъезжают на ноду через media[] (asset_picker → render_payload.f3_media → collect_media_urls).",
    "pools": {
      "camera_flash":   "sounds/camera_flash",
      "glitch":         "sounds/glitch",
      "subdrop":        "sounds/subdrop",
      "signature":      "sounds/signature",
      "car":            "sounds/car"
    },
    "pick": "random",
    "limits": { "max_duration_sec": 3, "fade_out_sec": 0.1 },
    "rules": {
      "drop_sound": { "source": "hook_only", "desc": "Звук на дропе даёт ТОЛЬКО хук: молния (hook light) или вспышка камеры (shutter / slow shutter). Сабдроп НЕ применяется." },
      "cut_sounds": { "scope": "before_drop_only", "per_cut": 1, "dedup": "transition+extra", "desc": "Звук перехода/грейда (его pool) вешается на склейки СТРОГО до дропа; после дропа — тишина. Один звук на склейку, переход и грейд между собой не дублируются." }
    },
    "user_sound": { "handled": false, "note": "Юзерский звук — отдельный формат, в этом разделе не трогаем." }
  },

  "clip_pools": {
    "_note": "Видео-пулы для эффектов, которые кладут видеоряд ПОВЕРХ футажа (не звук). Пути — S3-keys относительно FX_ASSETS_S3_PREFIX, доставка тем же media[]-транспортом.",
    "glitch_video": "video/glitch"
  },

  "effects": [
    { "id": "hook_light", "label": "Hook Light", "group": "hook", "apply_mode": "adjustment",
      "script": "hooks/rebuild_light.jsx", "needs_aep": false, "needs_plugin": ["Sapphire"],
      "branding": false, "branding_note": "Сам по себе сигнатурный (молнии/свет). Лого = оверфит, НЕ вешаем.",
      "sound": { "file": "sounds/light_sound/myinstants.mp3", "impact_at": 0.5, "sync": "impact_on_drop" },
      "default_duration": 0.63, "placement": "hook_start",
      "desc": "Молнии + вспышка + шейк. Фирменный хук Бласта (бренд держит сам визуал + Light Sound на дропе)." },

    { "id": "shutter_effect", "label": "Shutter", "group": "hook", "apply_mode": "adjustment",
      "script": "hooks/rebuild_shutter.jsx", "needs_aep": false, "needs_plugin": [],
      "branding": "built_in", "branding_note": "Лого-штамп уже в оригинале (Group 1245.png на нечётных чанках).",
      "sound": { "pool": "camera_flash", "sync": "on_drop" },
      "default_duration": 0.6, "placement": "hook_start",
      "desc": "Нарезка по 0.1с: смаз затвора + инверт/оверлей + встроенный лого-штамп." },

    { "id": "flash_slow_shutter", "label": "Slow Shutter", "group": "hook", "apply_mode": "adjustment",
      "script": "hooks/rebuild_flash_slow_shutter.jsx", "needs_aep": false, "needs_plugin": [],
      "branding": true, "branding_style": "stamp_flash", "branding_note": "Добавляем лого-штамп поверх (чистый канвас под бренд).",
      "sound": { "pool": "camera_flash", "sync": "on_drop" },
      "default_duration": 0.5, "placement": "hook_start",
      "extendable": true, "extend_options": ["to_end", "after_drop:N"],
      "extend_note": "Echo-шлейф можно растянуть: до конца ролика (футажи красиво наслаиваются) или на N футажей после дропа. Управляется job.hookExtend ('to_end' | 'after_drop:3'). Кандидат на доп. шаг в боте.",
      "desc": "Echo-шлейф + Posterize + вспышка экспозиции + лого-штамп Бласта." },

    { "id": "negative_zoom", "label": "Negative Zoom", "group": "hook", "apply_mode": "adjustment",
      "script": "hooks/rebuild_negative_zoom.jsx", "needs_aep": false, "needs_plugin": [],
      "branding": false,
      "branding_note": "Сигнатурный визуал (негатив-вспышка/зум). Лого = оверфит, НЕ вешаем.",
      "sound": { "pool": "camera_flash", "sync": "on_drop" },
      "default_duration": 0.25, "placement": "hook_start",
      "desc": "Негатив-зум на дропе: инверт-вспышка + зум (Geometry) + шум + пульс яркости. Нативный (Lumetri/Noise/Invert), без Sapphire." },

    { "id": "snap_wipe", "label": "Snap Wipe", "group": "transition", "apply_mode": "adjustment",
