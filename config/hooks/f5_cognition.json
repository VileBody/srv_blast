{
  "_comment": "Config for F5 Cognition hook. Providers are selected explicitly through F5_TEXT_PROVIDER and F5_TTS_PROVIDER; there is no implicit fallback.",
  "providers": {
    "text_provider_env": "F5_TEXT_PROVIDER",
    "tts_provider_env": "F5_TTS_PROVIDER",
    "supported": ["gemini", "openrouter"]
  },
  "gemini": {
    "text_model_env": "GEMINI_MODEL_F5_TEXT",
    "audio_model_env": "GEMINI_MODEL_F5_TTS",
    "api_key_env": "GEMINI_API_KEY",
    "timeout_sec": 30,
    "max_retries": 2
  },
  "openrouter": {
    "text_model_env": "OPENROUTER_MODEL_F5_TEXT",
    "audio_model_env": "OPENROUTER_MODEL_F5_TTS",
    "api_key_env": "OPENROUTER_API_KEY",
    "audio_format": "pcm16",
    "audio_sample_rate": 24000,
    "audio_max_tokens": 96,
    "audio_max_stream_seconds": 6,
    "timeout_sec": 120,
    "max_retries": 2,
    "allow_provider_fallbacks": false
  },
  "generation": {
    "tts_target_duration_ms": [2500, 3500],
    "tts_acceptable_window_ms": [1500, 4000],
    "tts_max_output_ms": 4000,
    "tts_cut_fade_ms": 80,
    "words_min": 3,
    "words_max": 8,
    "stage2_max_retries_on_short": 2
  },
  "mixing": {
    "duck_db": 4,
    "tts_offset_ms": 100,
    "tts_normalize_headroom_db": 3.0,
    "master_peak_dbfs": -1.0,
    "output_sample_rate": 48000,
    "output_channels": 2,
    "min_output_ms": 3000
  },
  "cache": {
    "enabled": false,
    "_comment": "Disabled to keep voice persona variety on repeated generations."
  },
  "logging": {
    "log_voice_persona": true,
    "log_rationale": true
  }
}
