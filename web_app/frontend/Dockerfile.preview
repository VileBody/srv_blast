FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund

COPY . ./
RUN npm run typecheck && npm run build
# заранее сжатые копии для gzip_static: nginx отдаёт .gz без сжатия на каждый запрос
RUN find dist -type f \( -name '*.js' -o -name '*.css' -o -name '*.svg' -o -name '*.json' -o -name '*.html' \) -size +1k       -exec sh -c 'gzip -9 -c "$1" > "$1.gz"' _ {} \;

FROM nginx:1.27-alpine

COPY nginx.preview.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=12 \
  CMD wget -q -T 3 -O /dev/null http://127.0.0.1/
