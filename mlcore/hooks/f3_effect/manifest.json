      "sound": { "pool": null, "optional": true }, "default_duration": 0.07, "placement": "at_cut",
      "desc": "Горизонтальная световая полоса: Transform+Directional Blur+Minimax+Optics." },

    { "id": "minimax", "label": "Minimax Flash", "group": "transition", "apply_mode": "adjustment",
