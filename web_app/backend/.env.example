# Мок-прототип не требует секретов. Эти переменные оставлены для будущей боевой интеграции.
DATABASE_URL=
NEXTAUTH_URL=https://blast808.com
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TBANK_TERMINAL_KEY=
TBANK_SECRET_KEY=
TBANK_WEBHOOK_SECRET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=f7cef916-asset-storage
S3_REGION=
# --- TikTok (Login Kit + Content Posting API) ---
# Берутся в кабинете developers.tiktok.com → твоё приложение → Credentials.
# client_key НЕ секретный (уходит в auth-URL), client_secret — СЕКРЕТ: только в .env (он в .gitignore),
# никогда в репозиторий и не в переписку. Если секрет где-то засветился — перевыпусти его в кабинете.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Должен совпадать с Redirect URI, прописанным в кабинете приложения
TIKTOK_REDIRECT_URI=http://localhost:8001/api/tiktok/callback
# video.publish — Direct Post (публикация), video.list — аналитика (Display API)
TIKTOK_SCOPES=user.info.basic,video.publish,video.list
# FILE_UPLOAD не требует верификации домена, с которого TikTok забирает ролик.
TIKTOK_UPLOAD_SOURCE=FILE_UPLOAD
# Куда бэк возвращает пользователя после OAuth
APP_URL=http://localhost:5173
ORCHESTRATOR_BASE_URL=
ORCHESTRATOR_API_KEY=

# --- Telegram verification bot (passwordless-вход) ---
# Токен бота из @BotFather. Пусто → бот выключен, верификация работает мок-фолбэком (dev).
TELEGRAM_BOT_TOKEN=
# Username бота без @ (для deep-link t.me/<username>?start=...)
TELEGRAM_BOT_USERNAME=blast808bot
