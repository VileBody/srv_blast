# Empty means same origin. In dev Vite proxy sends /api and /static to FastAPI.
VITE_API_BASE_URL=

# Реквизиты для юридических страниц (/legal/policy, /legal/offer).
# По умолчанию берутся те же, что на лендинге (см. LEGAL_ENTITY в src/data/legal-docs.ts):
# ИП Чернов Никита Романович. Эти переменные нужны, только если реквизиты сменятся —
# тогда правка идёт сюда, а не в код.
VITE_LEGAL_ENTITY=
VITE_LEGAL_INN=
VITE_LEGAL_OGRNIP=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_EMAIL=
VITE_LEGAL_PHONE=

# Внешние URL документов — задавать только если документы переедут с этого домена.
# По умолчанию используются внутренние страницы /legal/policy и /legal/offer.
VITE_LEGAL_POLICY_URL=
VITE_LEGAL_OFFER_URL=
