# Paste inside nginx `server {}` that should expose orchestrator endpoint.
# Example public URL: https://orchestrator.blast808.com/
#
# WARNING: the orchestrator API has NO authentication (/jobs/*, /jobs/{id}/edit_state,
# /asr/preview/from-job, ...). Its port is bound to 127.0.0.1 on purpose. Expose it
# only behind an IP allowlist (render nodes / office), never to the open internet:
#   allow <render-node-ip>; deny all;

location / {
    proxy_pass http://blast_orchestrator_api_ha;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    proxy_connect_timeout 5s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
}
